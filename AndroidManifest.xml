<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cc.liujiale.wxpad"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="36" />

    <!--
        无 Activity、无权限、无任何三方依赖。
        图标沿用原版「飞鱼」：API 26+ 走自适应图标（白底 + 飞鱼矢量前景），
        API 24/25 回退到 5 档密度的 webp 位图。素材来源见 NOTICE.md。
    -->
    <application
        android:label="@string/app_name"
        android:description="@string/module_description"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">

        <!--
            模块身份。新版框架（libxposed API 101+）不看这几行：它按
            META-INF/xposed/* 判定模块与作用域。保留 xposedmodule 是为了让
            模块仓库与旧版管理器仍能把这个 APK 识别为 Xposed 模块。
            注意不要写 xposedminversion —— 框架会把它的值直接显示成
            「Xposed 93」这样的旧 API 标签，而本模块走的是 API 102。
        -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="让微信把本机识别为 Lenovo TB-9707F 平板，使同一微信号可在手机与平板同时在线。" />

    </application>

</manifest>
